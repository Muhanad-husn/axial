# Axial analyst service (issue #691). Copy to `.env`, fill in the values
# with no default below, then `docker compose up`.
#
# This is the COMPLETE list -- if a setting is not in here, it is not
# configurable, and that is a bug (issue #691's own bar).

### Postgres ###
POSTGRES_USER=axial
POSTGRES_PASSWORD=axial
POSTGRES_DB=axial
# Must agree with the three values above -- compose does not derive one
# from the other three. Point this at a managed Postgres instead of the
# bundled container by changing only this line.
DATABASE_URL=postgresql://axial:axial@postgres:5432/axial

### Model access (axial.llm) ###
# No default -- an ask needs a real model call. The same
# OPENROUTER_API_KEY fallback `axial ask` itself already honours when
# secrets.toml has no [openrouter].api_key.
OPENROUTER_API_KEY=

# Optional. config/pipeline.yaml's model_by_pass routes several passes
# (envelope, retrieve, synthesize, ...) to named tiers that only resolve
# with a secrets.toml supplying them (see secrets/secrets.example.toml) --
# without one, every pass runs on the free `building` tier via
# OPENROUTER_API_KEY alone. To use the tiered models, put a real
# secrets.toml on the host and point AXIAL_SECRETS_HOST_PATH at it.
AXIAL_SECRETS_HOST_PATH=./secrets/secrets.toml
AXIAL_SECRETS_PATH=/secrets/secrets.toml

### Corpus snapshot (axial.service.snapshot, issue #684) ###
# The host directory `axial publish <version>` produced -- never a raw
# `data/sources/` checkout. Mounted read-only into both the API and the
# worker container at AXIAL_SNAPSHOT_DIR (docs/service-deployment.md
# explains why the API needs it too).
AXIAL_SNAPSHOT_HOST_PATH=./data/snapshots/current
AXIAL_SNAPSHOT_DIR=/snapshot

### Writable worker state -- analyses, run reports, the paper cache.
### Never the snapshot above, which stays read-only.
AXIAL_WORK_DIR=/work

### Citation rendering (issues #690, #785) ###
# passage (default): every claim carries the exact quoted passage it rests
# on. locator: source, chapter, section only -- no book text ever leaves the
# service, and a reader cannot check a claim's wording. The exposure is the
# deployer's to weigh; read docs/service-citation-mode.md and decide.
AXIAL_CITATION_MODE=passage

### Identity (issue #763) ###
# No default -- unset means every request is 401 (fail closed, never a
# shared dev account). Set to your Supabase project's JWKS URL, e.g.
# https://<project>.supabase.co/auth/v1/.well-known/jwks.json, before
# opening the service to anyone. Also confirm public sign-up is OFF in
# that Supabase project -- this service carries no second allowlist
# (docs/service-deployment.md).
AXIAL_SUPABASE_JWKS_URL=

### Per-analyst quotas (issue #686) ###
AXIAL_QUOTA_ASKS_PER_DAY=20
AXIAL_QUOTA_ASKS_PER_MONTH=300

### Worker concurrency and queue behaviour (issue #691) ###
# How many asks this one worker container runs concurrently.
AXIAL_WORKER_COUNT=1
# How long an empty queue is slept before asking again.
AXIAL_WORKER_POLL_SECONDS=2
# How long a claimed job may go without a heartbeat before it is
# presumed abandoned (its worker died) and returned to the queue.
AXIAL_WORKER_RECLAIM_AFTER_SECONDS=120

### API port on the host ###
AXIAL_API_PORT=8000
